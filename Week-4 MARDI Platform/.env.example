# --- LLM configuration ---
# Which provider to use in "live" mode: "gemini" (free tier available) or "anthropic"
LLM_PROVIDER=gemini

# Gemini — get a free key at https://aistudio.google.com (no card/phone needed)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Anthropic — optional alternative, get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-5

# auto | mock | live  ("auto" uses live if the active provider's key is set, else mock)
LLM_MODE=auto

# Hard cap (seconds) on a single live LLM call. If a call hangs past this
# (bad network, stalled proxy, SDK-internal stall) it is treated as a
# failure and retried once instead of blocking the workflow forever.
LLM_TIMEOUT_S=30

# --- Workflow controls ---
MAX_REVISIONS=2
TOOL_MAX_RETRIES=1
RESEARCH_CORPUS_PATH=app/storage/corpus

# --- Human-in-the-loop ---
# Set to true for non-interactive runs (CI, grading, demos) — auto-approves
# both checkpoints instead of prompting on stdin.
AUTO_APPROVE_CHECKPOINTS=false

# --- Observability ---
LOG_LEVEL=INFO
TRACE_DIR=traces
