# --- App ---
ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-in-production

# --- Database ---
DATABASE_URL=sqlite:///./ai_workspace.db

# --- Default model (drives provider selection automatically) ---
DEFAULT_MODEL=gemini-2.5-flash

# --- Provider API keys (set the one(s) you have) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Uploads / Vector store ---
UPLOAD_DIR=./uploads
VECTOR_STORE_PATH=./vector_store
CHUNK_SIZE=800
CHUNK_OVERLAP=120
