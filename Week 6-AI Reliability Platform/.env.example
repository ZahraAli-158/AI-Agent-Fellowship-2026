# Rename this file to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides — defaults already point at Google's current (Aug 2026)
# GA lineup: gemini-3.6-flash for chat, gemini-embedding-001 for embeddings.
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
SECRET_KEY=change_this_to_a_random_secret_string

# Leave DATABASE_URL commented out unless you need PostgreSQL/Supabase in
# production — config.py already computes a safe absolute path for the
# local SQLite file automatically. If you DO set this yourself, always use
# forward slashes (even on Windows) and prefer an absolute path, e.g.:
#   DATABASE_URL=sqlite:///D:/technical/technical/instance/platform.db
# A relative path like "sqlite:///instance/platform.db" depends on the
# folder you happen to launch Python from and can fail with
# "unable to open database file" if that folder doesn't match.
# DATABASE_URL=sqlite:///instance/platform.db

# Optional — enables the Meeting Agent's "email me my tasks" tool via
# Gmail SMTP. GMAIL_APP_PASSWORD is NOT your normal Gmail password:
#   1. Turn on 2-Step Verification on the Google account.
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Generate an app password for "Mail" and paste the 16-character
#      value below (spaces are fine, they're ignored).
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password
